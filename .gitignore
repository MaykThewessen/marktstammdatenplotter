# Claude Code local config
.claude/

# open-mastr snapshots, both regenerable via `pixi run db-mastr-core`:
#   data/mastr/parquet/      1.3 GB zstd parquet store (the default path)
#   data/mastr/open-mastr.db 11 GB legacy SQLite, only written with --sqlite.
# Both are symlinked from ~/.open-MaStR/data/{parquet,sqlite} so open-mastr's
# own writer refreshes the in-repo copy, and so git worktrees (whose own
# data/mastr/ is empty) resolve the store via mastr_parquet's HOME_DIR fallback
# instead of silently falling back to demo data.
data/mastr/

# geoBoundaries cache (refetched on demand by bess_income_by_bundesland.py).
data/geo/
